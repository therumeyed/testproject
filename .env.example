# Postgres connection (Render provides this automatically when using render.yaml)
DATABASE_URL=postgresql://user:password@localhost:5432/sportsgirl_beauty_radar
PORT=3000

# --- Market model ---
# global_validated (recommended default): discover globally, validate against
# Australia. australia_only: restrict discovery to Australian signals only.
MARKET_MODE=global_validated

# --- Apify (apify.com) -- powers TikTok, Instagram and Reddit collection ---
# Get a token from Apify Console -> Settings -> Integrations.
APIFY_TOKEN=

# Actor IDs are overridable so a deprecated/renamed actor doesn't require an
# ingestion-pipeline rewrite -- see README "Phase 0" notes on confirming these
# against real Apify Store listings before relying on them in production.
# APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
# APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
# APIFY_REDDIT_ACTOR_ID=trudax/reddit-scraper-lite

# Google Trends does NOT go through Apify -- src/collectors/googleTrends.js
# calls trends.google.com's own free public endpoints directly (no key, no
# cost). See that file's top comment for an important caveat: those
# endpoints are known to block requests from cloud/datacenter IPs, which
# may or may not include Render's -- check Admin -> Source Health after a
# run to confirm it's actually getting through in production.

# Per-query result cap for social collectors (cost control, see README section
# "Scrape budget").
APIFY_MAX_ITEMS_PER_QUERY=60

# How many discovery queries each collector attempts PER RUN, per platform
# (there are ~90+ seed keywords -- this bounds spend/time per run instead of
# trying to hit all of them at once). Each run also automatically skips any
# query that already succeeded today, so repeated runs on the same day make
# forward progress through the list rather than re-spending on the same
# terms; runs on later days naturally rotate through whatever's least
# recently succeeded first. Lower this further if you want to prioritise a
# small set of high-signal terms over broad coverage.
APIFY_MAX_QUERIES_PER_RUN=20
# How many of the top posts per platform per day get a deeper comment sample.
APIFY_DEEP_COMMENT_POST_LIMIT=10
APIFY_SHALLOW_COMMENT_LIMIT=15
APIFY_DEEP_COMMENT_LIMIT=60

# --- Anthropic (console.anthropic.com) -- topic clustering, conversation
# intelligence, social idea + buying recommendation generation ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Clustering is sampling-based, not per-post (see src/cluster.js top
# comment): most new posts get matched to an existing trend by simple text
# matching first (free, instant, no Claude call). Whatever's left gets
# word-phrase frequency counted in plain code (also free), and ONLY the
# top N most-repeated phrases per run get a Claude call each -- one call
# per phrase, not per post. This is why clustering cost no longer scales
# with how many posts you collect.
#
# How many of the top repeated phrases get a Claude call per run.
# CLUSTER_TOP_PHRASE_COUNT=15
# How many distinct posts a phrase must appear in to even be a candidate.
# CLUSTER_MIN_PHRASE_POSTS=3
#
# Model for those per-phrase calls -- only ~15 calls/run now, so Haiku is
# plenty. Override to a Sonnet model if match quality suffers.
# ANTHROPIC_CLUSTER_MODEL=claude-haiku-4-5-20251001

# --- Identity (no login gate -- see README "Auth model") ---
# There is no sign-in; the tool is open to anyone with the URL. This is
# only used to attribute audit-log/workflow-action entries to a name.
ADMIN_EMAILS=nitin4747@gmail.com
