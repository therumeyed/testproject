# Postgres connection (Render provides this automatically when using render.yaml)
DATABASE_URL=postgresql://user:password@localhost:5432/melair_mentions
PORT=3000

# What to search for. Defaults to "Melbourne Airport" if unset.
SEARCH_QUERY=Melbourne Airport

# --- Reddit (reddit.com/prefs/apps, create a "web app") ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- YouTube (Google Cloud Console -> enable "YouTube Data API v3" -> API key) ---
YOUTUBE_API_KEY=

# --- SerpApi (serpapi.com) -- powers site:facebook.com / site:instagram.com / site:linkedin.com / general web search ---
SERPAPI_KEY=

# --- Facebook (MelAir's own Page -- provided later) ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# --- Instagram (MelAir's own Business/Creator account -- provided later) ---
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
