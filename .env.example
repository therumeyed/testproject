# Postgres connection (Render provides this automatically when using render.yaml)
DATABASE_URL=postgresql://user:password@localhost:5432/melair_mentions
PORT=3000

# What to search for. Defaults to "Melbourne Airport" if unset.
SEARCH_QUERY=Melbourne Airport

# --- Apify (apify.com) -- powers Reddit, YouTube, the site:facebook.com /
# site:instagram.com / site:linkedin.com / general web search sources, and
# direct public Facebook/Instagram search (see README for what each covers).
# Get a token from Apify Console -> Settings -> Integrations.
APIFY_TOKEN=

# Optional overrides if you swap to a different Apify actor (see README).
# APIFY_REDDIT_ACTOR_ID=trudax/reddit-scraper-lite
# APIFY_YOUTUBE_ACTOR_ID=streamers/youtube-scraper
# APIFY_GOOGLE_SEARCH_ACTOR_ID=apify/google-search-scraper
# APIFY_FACEBOOK_ACTOR_ID=scrapeforge/facebook-search-posts
# APIFY_INSTAGRAM_ACTOR_ID=instaprism/instagram-hashtag-posts
# APIFY_GOOGLE_REVIEWS_ACTOR_ID=compass/google-maps-reviews-scraper

# Reddit is scoped to specific communities rather than a site-wide search --
# comma-separated, no r/. Defaults to "melbourne,australia" if unset.
# APIFY_REDDIT_SUBREDDITS=melbourne,australia

# Instagram has no free-text search -- this is hashtag(s) to track instead.
# Comma-separated, no #. Defaults to a slugified SEARCH_QUERY if unset.
# APIFY_INSTAGRAM_HASHTAGS=melbourneairport

# Google Business Profile reviews -- one identifier per car park listing.
# Accepts a numeric CID (from Business Profile Manager: business.google.com/
# n/.../profile?fid=NNNN -- that fid *is* the CID) or a standard Place ID
# (ChIJ...). Maps "Share" links do NOT work with the actor used here.
# Required for this source; it's skipped without it.
APIFY_GOOGLE_PLACE_IDS=

# --- Facebook (MelAir's own Page -- provided later) ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# --- Instagram (MelAir's own Business/Creator account -- provided later) ---
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# --- Anthropic (console.anthropic.com) -- sentiment classification ---
# Every newly-inserted mention each run is classified negative/neutral/
# positive (+ severity for negatives) using this. Skipped without it.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Resend (resend.com) -- sends the urgent alert + daily digest emails ---
# Sandbox sender (default EMAIL_FROM below) only delivers to the address
# you signed up to Resend with, until you verify a domain -- see README.
RESEND_API_KEY=
# EMAIL_FROM=onboarding@resend.dev
ALERT_EMAIL_TO=nitin@alleygroup.com.au

# --- Admin ---
# Gates POST /admin/reset-mentions (wipes mentions + ingest_runs -- see
# README). On Render this is auto-generated (generateValue: true in
# render.yaml); set your own locally if you want to test the endpoint.
ADMIN_TOKEN=
