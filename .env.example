# Postgres connection (Render provides this automatically when using render.yaml)
DATABASE_URL=postgresql://user:password@localhost:5432/sportsgirl_beauty_radar
PORT=3000

# --- Market model ---
# global_validated (recommended default): discover globally, validate against
# Australia. australia_only: restrict discovery to Australian signals only.
MARKET_MODE=global_validated

# --- Apify (apify.com) -- powers TikTok, Instagram and Reddit collection ---
# Get a token from Apify Console -> Settings -> Integrations.
APIFY_TOKEN=

# Actor IDs are overridable so a deprecated/renamed actor doesn't require an
# ingestion-pipeline rewrite -- see README "Phase 0" notes on confirming these
# against real Apify Store listings before relying on them in production.
# APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
# APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
# APIFY_REDDIT_ACTOR_ID=trudax/reddit-scraper-lite
# APIFY_GOOGLE_TRENDS_ACTOR_ID=emastra/google-trends-scraper

# Per-query result cap for social collectors (cost control, see README section
# "Scrape budget").
APIFY_MAX_ITEMS_PER_QUERY=60
# How many of the top posts per platform per day get a deeper comment sample.
APIFY_DEEP_COMMENT_POST_LIMIT=10
APIFY_SHALLOW_COMMENT_LIMIT=15
APIFY_DEEP_COMMENT_LIMIT=60

# --- Anthropic (console.anthropic.com) -- topic clustering, conversation
# intelligence, social idea + buying recommendation generation ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Admin ---
# Gates admin-only API routes (taxonomy edits, manual reruns, score-weight
# changes, CSV exports of raw evidence). On Render this is auto-generated
# (generateValue: true in render.yaml); set your own locally for testing.
ADMIN_TOKEN=

# Comma-separated emails allowed to sign in as admin. Everyone else who
# authenticates gets standard client (read + workflow-status) permissions.
# See README section 6 on the auth model shipped for MVP.
ADMIN_EMAILS=nitin4747@gmail.com

# --- App login (MVP auth -- see README "Auth model") ---
# Shared password gate: anyone with this password + an email can sign in.
# Their email decides role (admin if listed in ADMIN_EMAILS, else standard
# client). Swap for real SSO before a wider production rollout.
APP_ACCESS_PASSWORD=changeme
SESSION_SECRET=change-this-to-a-long-random-string
